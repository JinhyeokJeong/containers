Bootstrap: docker
From: python:3.12-slim-bookworm

%labels
    Description BayesFlow, PyMC, nutpie, and PyTorch CUDA 11.8 environment
    Python 3.12

%environment
    export KERAS_BACKEND=torch
    export PYTHONUNBUFFERED=1
    export PIP_DISABLE_PIP_VERSION_CHECK=1
    export XLA_PYTHON_CLIENT_PREALLOCATE=false

%post
    set -e

    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        git \
        graphviz \
        libopenblas-dev \
        pkg-config

    rm -rf /var/lib/apt/lists/*

    python -m pip install --upgrade pip setuptools wheel

    # PyTorch with CUDA 11.8
    python -m pip install --no-cache-dir \
        "torch==2.6.0+cu118" \
        --index-url https://download.pytorch.org/whl/cu118

    # Preserve the CUDA-enabled PyTorch build
    echo "torch==2.6.0+cu118" > /tmp/torch-constraints.txt

    python -m pip install --no-cache-dir \
        -c /tmp/torch-constraints.txt \
        "bayesflow>=2.0,<3.0" \
        "pymc[nutpie]>=6.2,<7.0" \
        "arviz>=1.2" \
        numpy \
        scipy \
        pandas \
        matplotlib \
        seaborn \
        scikit-learn \
        numba \
        jupyterlab \
        ipykernel \
        ipywidgets \
        tqdm \
        joblib \
        "sympy==1.13.1"

    rm /tmp/torch-constraints.txt

    # Verify installed dependencies
    python -m pip check

%test
    python -c \
        "import bayesflow, pymc, nutpie, arviz, torch, keras; \
        print('PyTorch:', torch.__version__); \
        print('PyTorch CUDA:', torch.version.cuda); \
        print('Keras backend:', keras.backend.backend()); \
        print('PyMC:', pymc.__version__); \
        print('Nutpie:', nutpie.__version__); \
        assert torch.__version__.startswith('2.6.0+cu118'); \
        assert torch.version.cuda == '11.8'; \
        assert keras.backend.backend() == 'torch'; \
        print('Imports successful')"

%runscript
    exec python "$@"
